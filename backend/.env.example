# Database Configuration (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://guardian:local_dev_password@localhost:5432/guardian

# PayPal Sandbox Credentials (obtained from https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM API Key (for Milestone 8+ Natural Language Policy Compiler, e.g. Gemini / OpenAI / Anthropic)
LLM_API_KEY=your_llm_api_key_here
